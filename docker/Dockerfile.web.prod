# ─────────────────────────────────────────────────────────────────────────────
# RideOS-AI — Production Flutter Web & Nginx Server
# ─────────────────────────────────────────────────────────────────────────────

FROM nginx:1.27-alpine

# Remove default nginx static assets
RUN rm -rf /usr/share/nginx/html/*

# Copy built Flutter web bundle to Nginx html directory
COPY apps/mobile/build/web /usr/share/nginx/html

# Copy custom production nginx configuration
COPY docker/nginx.conf /etc/nginx/nginx.conf

# Expose standard HTTP and HTTPS ports
EXPOSE 80 443

# Healthcheck probe for Nginx web server
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
