# RoadOS AI / RideOS AI — Environment Configuration Template
NODE_ENV=development
PORT=3000
HOST=localhost

# Database Connections
MONGO_URI=mongodb://localhost:27017/rideos
REDIS_HOST=localhost
REDIS_PORT=6379

# TimescaleDB / Telematics Database
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_USER=rideos_admin
TIMESCALE_PASSWORD=YOUR_SECURE_TIMESCALE_PASSWORD
TIMESCALE_DB=rideos_telemetry

# Security & Authentication Tokens
JWT_SECRET=YOUR_SECURE_JWT_SECRET_KEY
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=YOUR_SECURE_REFRESH_SECRET_KEY

# CORS Configuration (Comma-separated allowed web origins)
CORS_ALLOWED_ORIGINS=http://localhost:8080,https://app.rideos.ai,https://rideos.ai

# Google Maps Platform Credentials
# Required APIs to enable on Google Cloud Console:
# 1. Maps JavaScript API (for Web)
# 2. Places API (or Places API New)
# 3. Directions API
# 4. Geocoding API
# 5. Maps SDK for Android (for mobile builds)
# 6. Maps SDK for iOS (for mobile builds)
#
# Website Restrictions in Google Cloud Console:
# - Development: http://localhost:8080/* and http://127.0.0.1:8080/*
# - Production: https://<your-permanent-domain>/* (e.g. https://app.rideos.ai/* or https://<project-id>.web.app/*)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# AI & LLM Provider API Keys (Optional Cloud Integrations)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
GOOGLE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
