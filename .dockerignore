# Git & IDE metadata
.git
.github
.idea
.vscode
.DS_Store
*.iml

# Node / pnpm caches & dependencies
node_modules
apps/backend/node_modules
.pnpm-store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build artifacts
dist
apps/backend/dist
*.tsbuildinfo

# Mobile platform native directories & build caches
apps/mobile/.dart_tool
apps/mobile/.flutter-plugins
apps/mobile/.flutter-plugins-dependencies
apps/mobile/android/.gradle
apps/mobile/android/app/build
apps/mobile/ios
apps/mobile/macos
apps/mobile/linux
apps/mobile/windows
release/

# Test coverage & temporary reports
coverage/
*.log
