# ==============================================================================
# RideOS-AI — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env on your deployment host and fill in production secrets.
# NEVER commit the real .env file or production credentials to source control.
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# ------------------------------------------------------------------------------
# 1. MongoDB Database Cluster
# ------------------------------------------------------------------------------
MONGO_URI=mongodb://mongo_prod_user:prod_password@mongodb:27017/rideos?authSource=admin

# ------------------------------------------------------------------------------
# 2. TimescaleDB / PostgreSQL Telemetry Time-Series Database
# ------------------------------------------------------------------------------
TIMESCALE_HOST=timescaledb
TIMESCALE_PORT=5432
TIMESCALE_USER=timescale_prod_user
TIMESCALE_PASSWORD=prod_timescale_password
TIMESCALE_DATABASE=rideos_telemetry

# ------------------------------------------------------------------------------
# 3. Redis High-Performance Cache & Session Store
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. JWT Cryptographic Signing Secrets (Use 256-bit+ secure random keys)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_strong_production_256bit_access_secret
JWT_REFRESH_SECRET=replace_with_strong_production_256bit_refresh_secret
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ------------------------------------------------------------------------------
# 5. Google Maps Platform (Directions, Geocoding, Places)
# ------------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=replace_with_production_google_maps_api_key

# ------------------------------------------------------------------------------
# 6. OAuth Providers (Google & Apple ID Token Cryptographic Verification)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=replace_with_production_google_oauth_client_id.apps.googleusercontent.com
APPLE_CLIENT_ID=ai.rideos.app

# ------------------------------------------------------------------------------
# 7. Firebase Cloud Messaging (FCM Push Notifications & Emergency SOS)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=rideos-production
FIREBASE_SERVER_KEY=replace_with_production_firebase_server_key

# ------------------------------------------------------------------------------
# 8. Twilio Cellular SMS Gateway (2FA / OTP Delivery)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=replace_with_production_twilio_account_sid
TWILIO_AUTH_TOKEN=replace_with_production_twilio_auth_token
TWILIO_FROM_PHONE=+1234567890

# ------------------------------------------------------------------------------
# 9. Google Gemini AI Engine
# ------------------------------------------------------------------------------
GEMINI_API_KEY=replace_with_production_gemini_api_key
