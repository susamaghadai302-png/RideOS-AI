# ============================================================
# RideOS AI — Mobile Environment Configuration
# ============================================================
# Copy this file to .env (which is gitignored) and fill in
# your actual values. Never commit real keys to source control.

# Google Maps API Key
# Obtain from: https://console.cloud.google.com/apis/credentials
# Required APIs: Maps SDK for Android, Maps SDK for iOS,
#                Maps JavaScript API, Places API, Directions API,
#                Geocoding API
GOOGLE_MAPS_API_KEY=YOUR_ACTUAL_GOOGLE_MAPS_API_KEY_HERE

# Backend API URL
# Development: http://localhost:3000/api/v1
# Production: https://api.rideos.ai/api/v1
API_BASE_URL=http://localhost:3000/api/v1
