{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "RideOS AI Enterprise Backend API",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/backend/src/main",
