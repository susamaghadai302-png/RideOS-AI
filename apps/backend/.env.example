# ============================================================
# RideOS AI — Backend Environment Configuration
# ============================================================
# Copy this to .env and fill in production values.
# NEVER commit your .env to source control.

# Application
NODE_ENV=development
PORT=3000

# CORS (comma-separated allowed origins for production)
# Leave empty to auto-detect from NODE_ENV
CORS_ALLOWED_ORIGINS=

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/rideos

# Redis (optional — app degrades gracefully if unavailable)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# TimescaleDB / PostgreSQL (optional — app degrades gracefully)
TIMESCALE_HOST=127.0.0.1
TIMESCALE_PORT=5432
TIMESCALE_USER=rideos_admin
TIMESCALE_PASSWORD=CHANGE_ME_IN_PRODUCTION
TIMESCALE_DB=rideos_telemetry

# JWT — CRITICAL: Use strong random secrets in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_64_CHARS_MINIMUM
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=CHANGE_ME_TO_A_DIFFERENT_STRONG_RANDOM_SECRET_64_CHARS
JWT_REFRESH_EXPIRATION=30d

# Google Maps & Google Routes API (Routes API v2 TWO_WHEELER motorcycle navigation)
GOOGLE_ROUTES_API_KEY=
GOOGLE_MAPS_API_KEY=

# Mapbox (optional — only for Mapbox routing provider)
MAPBOX_ACCESS_TOKEN=

# Twilio SMS OTP (required for production phone authentication)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Firebase Push Notifications (optional)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
